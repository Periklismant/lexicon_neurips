    ]
    effects = [
      inReceptacle(o, r) := false
      holds(a, o) := true
      holdsAny(a) := true
      objectAtLocation(o, l) := false
    ]
  }
  action putObject(Agent - Checkable a, Location - Checkable l, Obj - Checkable o, Receptacle - Checkable r, ObjectType ot, ReceptacleType rt) {
